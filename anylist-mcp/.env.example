# --- AnyList account (required) -------------------------------------------
ANYLIST_EMAIL=you@example.com
ANYLIST_PASSWORD=your-anylist-password

# Optional: cache the library's AnyList session (encrypted with your password) so
# restarts don't need a fresh login. Leave empty to keep it in memory only.
# ANYLIST_CREDENTIALS_FILE=/data/anylist-credentials

# --- Transport ---------------------------------------------------------------
# "stdio" (default, for local Claude Desktop / Claude Code) or "http".
# The --stdio / --http command-line flags override this.
MCP_TRANSPORT=stdio

# --- HTTP mode only ----------------------------------------------------------
# Required for HTTP. Static bearer token AND the password you type on the OAuth
# approval page. Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=
HOST=0.0.0.0
PORT=3000

# Public HTTPS URL of this server (no path). Enables OAuth, which claude.ai
# custom connectors need. Example: https://anylist.example.com
# PUBLIC_URL=

# Persist OAuth clients + hashed tokens so Claude stays connected across restarts.
# OAUTH_STATE_FILE=/data/oauth-state.json

# Hosts OAuth clients may redirect to (comma separated).
# OAUTH_ALLOWED_REDIRECT_HOSTS=claude.ai,claude.com,localhost,127.0.0.1

# Set to 1 when running behind a reverse proxy (Fly.io, Caddy, nginx).
# TRUST_PROXY=1

# info (default), debug, or silent. Logs go to stderr and are redacted.
# LOG_LEVEL=info

# Hetzner docker-compose only: domain Caddy gets a TLS certificate for.
# DOMAIN=anylist.example.com
